{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('role').val() === 'ADMIN'",
        ".validate": "newData.hasChildren(['userId', 'name', 'email', 'role', 'storeId', 'active'])"
      }
    },
    "stores": {
      "$storeId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('storeId').val() === $storeId || root.child('users').child(auth.uid).child('role').val() === 'ADMIN')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('role').val() === 'ADMIN'",
        ".validate": "newData.hasChildren(['storeId', 'storeCode', 'storeName', 'active'])"
      }
    },
    "products": {
      "$productId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'MANAGER' || root.child('users').child(auth.uid).child('role').val() === 'SUPERVISOR' || root.child('users').child(auth.uid).child('role').val() === 'INVENTORY_USER')",
        ".validate": "newData.hasChildren(['id', 'sku', 'productName', 'retailPrice', 'active', 'inventoryMode'])"
      }
    },
    "ingredients": {
      "$ingredientId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'MANAGER' || root.child('users').child(auth.uid).child('role').val() === 'SUPERVISOR' || root.child('users').child(auth.uid).child('role').val() === 'INVENTORY_USER')",
        ".validate": "newData.hasChildren(['id', 'ingredientSku', 'ingredientName', 'unitOfMeasure', 'active'])"
      }
    },
    "unitsOfMeasure": {
      "$unitId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'MANAGER' || root.child('users').child(auth.uid).child('role').val() === 'SUPERVISOR' || root.child('users').child(auth.uid).child('role').val() === 'INVENTORY_USER')",
        ".validate": "newData.hasChildren(['id', 'code', 'name', 'unitType', 'conversionFactor', 'allowDecimal', 'active', 'createdAt', 'updatedAt', 'serverVersion']) && newData.child('id').val() === $unitId && newData.child('code').isString() && newData.child('name').isString() && newData.child('conversionFactor').isNumber() && newData.child('conversionFactor').val() > 0 && newData.child('allowDecimal').isBoolean() && newData.child('active').isBoolean() && newData.child('serverVersion').isNumber()"
      },
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true"
    },
    "suppliers": {
      "$supplierId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'MANAGER' || root.child('users').child(auth.uid).child('role').val() === 'SUPERVISOR' || root.child('users').child(auth.uid).child('role').val() === 'INVENTORY_USER')",
        ".validate": "newData.hasChildren(['id', 'supplierCode', 'supplierName', 'leadTimeDays', 'active', 'createdAt', 'updatedAt', 'serverVersion']) && newData.child('id').val() === $supplierId && newData.child('supplierCode').isString() && newData.child('supplierName').isString() && newData.child('leadTimeDays').isNumber() && newData.child('leadTimeDays').val() >= 0 && newData.child('active').isBoolean() && newData.child('serverVersion').isNumber()"
      },
      ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true"
    },
    "inventoryMovements": {
      "$movementId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && !data.exists()"
      }
    },
    "ingredientMovements": {
      "$movementId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true",
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && !data.exists()"
      }
    },
    "sales": {
      "$saleId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && data.child('storeId').val() === root.child('users').child(auth.uid).child('storeId').val()",
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && newData.child('storeId').val() === root.child('users').child(auth.uid).child('storeId').val() && (!data.exists() || data.val() === newData.val())"
      }
    },
    "auditLogs": {
      "$auditId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && root.child('users').child(auth.uid).child('role').val() === 'ADMIN'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('active').val() === true && !data.exists()"
      }
    }
  }
}
